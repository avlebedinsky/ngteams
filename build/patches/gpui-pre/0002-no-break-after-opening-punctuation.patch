-                if ch != ' ' && first_non_whitespace_ix.is_some() {
+                if ch != ' '
+                    && first_non_whitespace_ix.is_some()
+                    && !LineWrapper::is_opening_punctuation(prev_ch)
+                {
                     last_candidate_ix = Some(boundary);
                     last_candidate_x = x;
                 }
