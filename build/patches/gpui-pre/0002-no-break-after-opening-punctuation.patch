+    /// Opening punctuation, after which no line ends (UAX #14 LB14).
+    #[inline(always)]
+    pub(crate) fn is_opening_punctuation(c: char) -> bool {
+        matches!(c, '(' | '[' | '{' | '“' | '«')
+    }
