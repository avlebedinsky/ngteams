      "socket": "regional",
      "frame": "5:::{\"name\":\"user.authenticate\",\"args\":[{\"headers\":{\"X-Ms-Test-User\":\"False\",\"Authorization\":\"Bearer <token:1>\",\"X-MS-Migration\":\"True\"},\"connectparams\":{\"issuer\":\"\",\"scae\":\"1\",\"sig\":\"\",\"sr\":\"SyntheticSession000000\",\"sp\":\"pub-ent-zz-01\",\"se\":\"1700000600000\",\"st\":\"1700000000000\"}}]}",
      "expected": "allow"
    },
    {
