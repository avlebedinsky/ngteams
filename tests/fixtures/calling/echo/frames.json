      "socket": "first",
      "frame": "3:::{\"id\":1234567,\"status\":200,\"headers\":{\"MS-CV\":\"SyntheticCorrelation00.1.0\",\"trouter-request\":\"{\\\"id\\\":\\\"x\\\",\\\"src\\\":\\\"y\\\"}\",\"trouter-client\":\"{\\\"cd\\\":2}\"},\"body\":\"\"}",
      "expected": "unknown"
