    {
      "name": "the acknowledgement of the service's message-loss report",
      "socket": "regional",
      "frame": "5:3+::{\"name\":\"trouter.processed_message_loss\",\"args\":[{\"droppedIndicators\":[{\"tag\":\"\",\"etag\":\"2000-01-01T00:00:00.0000000Z\"},{\"tag\":\"messaging\",\"etag\":\"2000-01-01T00:00:00.0000001Z\"}]}]}",
      "expected": "allow"
