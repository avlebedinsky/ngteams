# Release tools and the portable WPE WebKit prefix, each checksum- or digest-verified before it is used.

# ngterm's relocatable WPE WebKit 2.54 build, built on Ubuntu 24.04 and published to GHCR by its release-wpe-cache.yml.
# Its .pc files name RELEASE_WPE_PREFIX, so it is unpacked there. The digest is what scripts/release-wpe-pull.sh and
# scripts/package-web-engine.sh use; the tag says which build it is.
RELEASE_WPE_REPOSITORY="ghcr.io/nickalie/ngterm-release-wpe"
RELEASE_WPE_TAG="ubuntu-24.04-6935d36ad48b9b2473cbf3cd295c19ac4d0f2e21f0f4ad40e360c3874e63675c"
RELEASE_WPE_DIGEST="sha256:e5b4a3446a94c71049f39da65deac61d565ce7b4c2125bf7a1fbf0ac14a1f387"
RELEASE_WPE_PREFIX="/home/runner/.cache/ngterm/release-wpe"

# ORAS, which pulls that prefix: its GitHub release's Linux .tar.gz, with the sha256 from its checksums.txt.
ORAS_VERSION="1.3.6"
ORAS_X86_64_SHA256="66fb0ad7206f3f6fa77ed5b552049d364ccf4b50b1684554f731f76302b52ca0"

# The packaging tools of scripts/package-release.sh.
APPIMAGETOOL_VERSION="1.9.1"
APPIMAGETOOL_X86_64_SHA256="ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0"
APPIMAGE_RUNTIME_VERSION="20251108"
APPIMAGE_RUNTIME_X86_64_SHA256="2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d"
NFPM_VERSION="2.48.0"
NFPM_X86_64_SHA256="6d7f9a28b2f397934403950fcbba83f598b08d02edbe79a0815b3b4897341750"
