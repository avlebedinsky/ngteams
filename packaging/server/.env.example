# Copy to .env beside compose.yaml and fill in. Keep .env private: it holds the deployment's secrets.
# Make each secret with: openssl rand -hex 32   (hex only: the values go into URLs unescaped)

# The name clients reach the server at; its DNS must point at this host.
NGTEAMS_DOMAIN=teams.example.com
# An IPv4 address of this host (public or private): coturn reaches the media node there.
HOST_IP=203.0.113.10

POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
TURN_SECRET=change-me

# Optional
# S3_BUCKET=ngteams
# NGTEAMS_SERVER_IMAGE=ngteams-server:latest
# NGTEAMS_SERVER_LOG=info
# HTTP_PORT=80
# HTTPS_PORT=443
# NGTEAMS_PUBLIC_ORIGIN=https://teams.example.com      # only when HTTPS_PORT isn't 443: https://<domain>:<port>
# MEDIA_UDP_PORT=50000
# TURN_PORT=3478
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49359
# TURN_EXTERNAL_IP=203.0.113.10/10.0.0.5               # behind 1:1 NAT: <public>/<private>, coturn's external-ip
# CADDY_GLOBAL_OPTIONS=local_certs                     # Caddy's own CA instead of Let's Encrypt (no public DNS)
